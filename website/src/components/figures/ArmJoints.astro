---
import ArmSide from "./ArmSide.astro";
// 初始位下各关节的位置（由运动学按初始位角度算出，厘米）
const s = 9, x = 150, y = 262;
const J = [[3.9, 6.2], [6.9, 11.7], [-3.2, 17.3], [9.7, 21.3], [15.8, 21.8], [22.5, 22.4]].map(([f, u]) => [x + f * s, y - u * s]);
// 编号牌相对关节的偏移，避开连杆
const off = [[-34, 8], [34, 6], [-30, -18], [-4, -34], [26, 30], [30, -30]];
const rows = [
  ["肩部旋转", "shoulder_pan"], ["肩部俯仰", "shoulder_lift"], ["肘部", "elbow_flex"],
  ["腕部俯仰", "wrist_flex"], ["腕部旋转", "wrist_roll"], ["夹爪", "gripper"],
];
---
<figure class="fg">
  <svg viewBox="0 0 480 290" role="img" aria-labelledby="joints-t joints-d">
    <title id="joints-t">一只机械臂上的六个舵机</title>
    <desc id="joints-d">侧视图。从基座到夹爪依次是：ID 1 肩部旋转，ID 2 肩部俯仰，ID 3 肘部，ID 4 腕部俯仰，ID 5 腕部旋转，ID 6 夹爪。腕部相机装在夹爪上方。</desc>
    <path class="fg-floor" d="M60 262 H440" />
    <ArmSide x={x} y={y} s={s} pose={{ lift: -75, elbow: 60, wrist: 10 }} />
    {J.map((p, i) => (
      <g>
        <path class="fg-lead" d={`M${p[0]} ${p[1]} L${p[0] + off[i][0]} ${p[1] + off[i][1]}`} />
        <circle class="fg-id" cx={p[0] + off[i][0]} cy={p[1] + off[i][1]} r="13" />
        <text class="fg-t fg-idn" x={p[0] + off[i][0]} y={p[1] + off[i][1] + 5} text-anchor="middle">{i + 1}</text>
      </g>
    ))}
  </svg>
  <ol class="fg-key cols">
    {rows.map(([name, key], i) => <li><b>{i + 1}</b><span>{name} <code>{key}</code></span></li>)}
  </ol>
  <figcaption>每只臂 6 个舵机，ID 从基座往夹爪依次是 1 到 6，<code>scan</code> 的输出和配置里的关节名都按这个顺序。红色方块是腕部相机。</figcaption>
</figure>
