---
// 人手的小图形，中心在 (x, y)
interface Props { x: number; y: number; r?: number }
const { x, y, r = 0 } = Astro.props;
---
<g class="fg-hand" transform={`translate(${x} ${y}) rotate(${r})`}>
  <rect x="-10" y="-17" width="4.6" height="15" rx="2.3" /><rect x="-4.8" y="-21" width="4.6" height="19" rx="2.3" />
  <rect x="0.4" y="-20" width="4.6" height="18" rx="2.3" /><rect x="5.6" y="-16" width="4.6" height="14" rx="2.3" />
  <rect x="-11" y="-5" width="22" height="17" rx="7" />
</g>
